 .../tests/test_file_operations.py                         | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/katas/natural-language-calculator/tests/test_file_operations.py b/katas/natural-language-calculator/tests/test_file_operations.py
index a15ba06..e044537 100644
--- a/katas/natural-language-calculator/tests/test_file_operations.py
+++ b/katas/natural-language-calculator/tests/test_file_operations.py
@@ -14,7 +14,7 @@ def create_test_file(tmp_path, filename, content):
     return filepath
 
 
-def test_basic_file_processing(tmp_path,capsys):
