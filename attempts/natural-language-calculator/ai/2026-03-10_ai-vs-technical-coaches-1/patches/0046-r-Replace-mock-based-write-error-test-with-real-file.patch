+def test_write_error(test_dir, capsys):
+    readonly_dir = os.path.join(test_dir, 'readonly')
+    os.makedirs(readonly_dir)
+    input_file = create_test_file(readonly_dir, 'test.txt', 'one plus one\n')
+    os.chmod(readonly_dir, 0o555)
+
+    try:
+        exit_code = main(input_file)
+
+        assert exit_code == 1
+
+        captured = capsys.readouterr()
+        assert 'Could not write' in captured.out
+    finally:
+        os.chmod(readonly_dir, 0o755)
+
+
 def test_subprocess_integration(test_dir):
