diff --git a/katas/natural-language-calculator/src/natural_language_calculator.py b/katas/natural-language-calculator/src/natural_language_calculator.py
index 436b203..8b4895a 100644
--- a/katas/natural-language-calculator/src/natural_language_calculator.py
+++ b/katas/natural-language-calculator/src/natural_language_calculator.py
@@ -2,6 +2,26 @@ import sys
 
 from processor import process_line
 
+
+def read_expressions(filepath):
+    with open(filepath, 'r') as f:
+        return [line.strip() for line in f if line.strip()]
+
+
+def calculate_all(expressions):
+    return [process_line(expr) for expr in expressions]
+
+
+def write_results(filepath, results):
+    with open(filepath, 'w') as f:
+        for r in results:
+            f.write(str(r) + '\n')
+
+
+def output_filepath(input_filepath):
+    return input_filepath.replace('.txt', '_results.txt')
+
+
 def main(input_file=None):
     if input_file is None:
         if len(sys.argv) < 2:
@@ -10,33 +30,15 @@ def main(input_file=None):
         input_file = sys.argv[1]
 
