From 94e79f037ae17263ed78539dac0660ad60f1ec0c Mon Sep 17 00:00:00 2001
From: Lada Kesseler <archie.kesseler@gmail.com>
Date: Fri, 6 Mar 2026 19:55:40 -0800
Subject: [PATCH 24/56] - r Rename test methods to describe behavior instead of
 mechanism

---
 katas/natural-language-calculator/tests/test_calculator.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/katas/natural-language-calculator/tests/test_calculator.py b/katas/natural-language-calculator/tests/test_calculator.py
index 18a6045..57dcbbd 100644
--- a/katas/natural-language-calculator/tests/test_calculator.py
+++ b/katas/natural-language-calculator/tests/test_calculator.py
@@ -58,7 +58,7 @@ class TestEvaluateExpression(unittest.TestCase):
         self.assertEqual(evaluate_expression('six divided by two'), 3)
         self.assertAlmostEqual(evaluate_expression('three divided by nine'), 0.333, places=2)
 
-    def test_just_a_number(self):
+    def test_single_number_returns_itself(self):
         self.assertEqual(evaluate_expression('five'), 5)
         self.assertEqual(evaluate_expression('10'), 10)
 
@@ -149,7 +149,7 @@ class TestCalculate(unittest.TestCase):
         self.assertEqual(result, 6)
         self.assertIsInstance(result, int)
 
-    def test_comma_divided_nested(self):
+    def test_comma_precedence_with_nested_divisor(self):
         result = calculate('six plus four, divided by the result of one plus one')
         self.assertEqual(result, 5)
         self.assertIsInstance(result, int)
