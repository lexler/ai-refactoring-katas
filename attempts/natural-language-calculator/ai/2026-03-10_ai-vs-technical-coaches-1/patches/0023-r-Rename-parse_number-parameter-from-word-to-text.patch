 katas/natural-language-calculator/src/number_words.py | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/katas/natural-language-calculator/src/number_words.py b/katas/natural-language-calculator/src/number_words.py
index 9ecfa00..aa570e6 100644
--- a/katas/natural-language-calculator/src/number_words.py
+++ b/katas/natural-language-calculator/src/number_words.py
@@ -13,10 +13,10 @@ NUMBER_WORDS = {
 }
 
 
-def parse_number(word):
-    word = word.strip().lower()
+def parse_number(text):
+    text = text.strip().lower()
 
-    if word in NUMBER_WORDS:
-        return NUMBER_WORDS[word]
+    if text in NUMBER_WORDS:
+        return NUMBER_WORDS[text]
 
-    return int(word)
+    return int(text)
