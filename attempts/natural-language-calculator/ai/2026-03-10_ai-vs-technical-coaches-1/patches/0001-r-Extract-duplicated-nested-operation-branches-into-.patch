+import operator
 from utils import get_num
 
 RESULT_PREFIX = 'the result of '
 
+OPERATIONS = {
+    'plus': operator.add,
+    'minus': operator.sub,
+    'times': operator.mul,
+    'divided by': operator.truediv,
+}
+
+NESTED_DELIMITERS = []
+for op_name in OPERATIONS:
+    NESTED_DELIMITERS.append(f', {op_name} the result of ')
+    NESTED_DELIMITERS.append(f' {op_name} the result of ')
+
 def normalize_line(line):
     line = line.lower()
     if line.startswith(RESULT_PREFIX):
         line = line[len(RESULT_PREFIX):]
     return line
 
+def find_nested_delimiter(line):
+    for delimiter in NESTED_DELIMITERS:
+        if delimiter in line:
+            return delimiter
+    return None
+
+def apply_nested_operation(line, delimiter):
+    op_name = delimiter.strip(', ').replace(' the result of', '')
+    parts = line.split(delimiter)
+    left_val = calc_simple(parts[0])
+    right_val = calc_simple(parts[1])
+    return OPERATIONS[op_name](left_val, right_val)
+
+def format_result(result):
+    if result == int(result):
+        return int(result)
+    return round(result, 2)
+
