#!/bin/bash
set -euo pipefail

cleanup() {
  echo ""
  echo "==== shutting down ===="
  kill 0
  wait
  exit 0
}

trap cleanup SIGINT SIGTERM

while true; do
  echo "==== starting iteration ===="
  claude -p "$(cat prompt.md)" --allowedTools "Bash(bin/*)" "Bash(yx *)" "Read" "Write" "Edit" &
  wait $!
done
